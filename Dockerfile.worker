FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/eodhd-client/package.json packages/eodhd-client/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile

# Build
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/prisma/ apps/api/prisma/
COPY apps/worker/ apps/worker/
RUN pnpm --filter @stock-screener/shared build
RUN pnpm --filter @stock-screener/eodhd-client build
RUN pnpm --filter @stock-screener/api db:generate
RUN pnpm --filter @stock-screener/worker build

# Production
FROM deps AS production
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
RUN pnpm --filter @stock-screener/api db:generate
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/eodhd-client/dist ./packages/eodhd-client/dist
COPY --from=build /app/apps/worker/dist ./apps/worker/dist
# Keep TS scripts so they can be run via: docker compose exec worker npx tsx src/scripts/...
COPY --from=build /app/apps/worker/src/scripts ./apps/worker/src/scripts

WORKDIR /app/apps/worker
CMD ["node", "dist/index.js"]
