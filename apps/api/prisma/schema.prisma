generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Exchange ───────────────────────────────────────────

model Exchange {
  id       String  @id // "US", "PA", "LSE", "XETRA"
  name     String // "NASDAQ", "Euronext Paris"
  country  String
  currency String // "USD", "EUR", "GBP"
  timezone String

  stocks Stock[]

  updatedAt DateTime @updatedAt
}

// ─── Stock (denormalized for screener performance) ──────

model Stock {
  id         String   @id @default(cuid())
  ticker     String // "AAPL"
  exchange   Exchange @relation(fields: [exchangeId], references: [id])
  exchangeId String
  name       String // "Apple Inc."
  isin       String?
  type       String   @default("Common Stock") // "Common Stock", "ETF", "Fund"
  sector     String?
  industry   String?
  currency   String // "USD"
  isActive   Boolean  @default(true)

  // ── Denormalized fundamentals (latest snapshot) ──
  marketCap       Float?
  peRatio         Float?
  forwardPe       Float?
  pegRatio        Float?
  eps             Float?
  dilutedEps      Float? // Diluted EPS TTM
  revenue         Float?
  revenueGrowth   Float? // YoY quarterly
  earningsGrowth  Float? // YoY quarterly earnings growth
  grossMargin     Float? // as decimal 0.0 - 1.0
  operatingMargin Float?
  netMargin       Float?
  roe             Float?
  roa             Float? // Return on Assets TTM
  debtToEquity    Float?
  currentRatio    Float? // currentAssets / currentLiabilities
  dividendYield   Float?
  beta            Float?
  week52High      Float?
  week52Low       Float?
  evToEbitda      Float?
  evToRevenue     Float? // Enterprise Value / Revenue
  pbRatio         Float?
  psRatio         Float? // Price / Sales TTM
  enterpriseValue Float?
  ebitda          Float? // EBITDA from Highlights
  freeCashFlow    Float? // FCF from latest data
  fcfYield        Float? // freeCashFlow / marketCap

  // ── Cash-flow & debt metrics (Pikpik strategy) ──
  operatingCashFlow Float? // Operating CF from latest quarterly
  totalDebt         Float? // Long-term debt
  cashAndEquiv      Float? // Cash & short-term investments
  totalEquity       Float? // Total stockholder equity
  netDebt           Float? // totalDebt - cashAndEquiv
  priceToOCF        Float? // marketCap / operatingCashFlow
  netDebtToOCF      Float? // netDebt / operatingCashFlow
  equityToMarketCap Float? // totalEquity / marketCap
  revenueCAGR5Y     Float? // 5-year revenue CAGR

  // ── Quality Score (Pikpik methodology) ──
  qualityScore Float? // 0-100 composite quality score

  // ── Analyst / ownership ──
  targetPrice        Float? // Wall Street consensus target
  pctInsiders        Float? // % held by insiders
  pctInstitutions    Float? // % held by institutions
  shortPctFloat      Float? // short interest as % of float

  // ── Computed relative price fields ──
  pctFrom52WeekHigh Float? // (lastPrice - week52High) / week52High, e.g. -0.15 = 15% below
  pctFrom52WeekLow  Float? // (lastPrice - week52Low) / week52Low, e.g. 0.30 = 30% above

  // ── Denormalized latest price ──
  lastPrice      Float?
  lastVolume     BigInt?
  priceUpdatedAt DateTime?

  // ── Relations ──
  priceHistory DailyPrice[]
  fundamentals Fundamentals[]
  bookmarks    Bookmark[]
  alerts       Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, exchangeId])
  @@index([sector])
  @@index([industry])
  @@index([marketCap])
  @@index([peRatio])
  @@index([lastPrice])
  @@index([dividendYield])
  @@index([roe])
  @@index([roa])
  @@index([netMargin])
  @@index([debtToEquity])
  @@index([psRatio])
  @@index([isActive])
  @@index([exchangeId, isActive])
  @@index([qualityScore])
}

// ─── Daily Prices ───────────────────────────────────────

model DailyPrice {
  id       String   @id @default(cuid())
  stock    Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId  String
  date     DateTime @db.Date
  open     Float
  high     Float
  low      Float
  close    Float
  adjClose Float // Adjusted for splits + dividends
  volume   BigInt

  @@unique([stockId, date])
  @@index([date])
  @@index([stockId, date(sort: Desc)])
}

// ─── Fundamental Snapshots ──────────────────────────────

model Fundamentals {
  id      String   @id @default(cuid())
  stock   Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId String
  period  String // "Q1-2024", "FY-2024"
  type    String // "quarterly" | "annual"
  date    DateTime @db.Date

  // Income Statement
  revenue         Float?
  grossProfit     Float?
  operatingIncome Float?
  netIncome       Float?
  eps             Float?

  ebitda          Float?

  // Balance Sheet
  totalAssets          Float?
  totalCurrentAssets   Float?
  totalDebt            Float?
  totalCurrentLiab     Float?
  totalEquity          Float?
  cashAndEquiv         Float?

  // Cash Flow
  operatingCF  Float?
  capex        Float?
  freeCashFlow Float?

  // Ratios
  peRatio    Float?
  pbRatio    Float?
  evToEbitda Float?

  createdAt DateTime @default(now())

  @@unique([stockId, period])
  @@index([date])
  @@index([stockId, type])
}

// ─── User ───────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // scrypt hash
  name      String
  role      String   @default("viewer") // "super_admin" | "admin" | "viewer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presets       ScreenerPreset[]
  emailDigests  EmailDigest[]
  bookmarks     Bookmark[]
  alerts        Alert[]
}

// ─── Screener Presets (saved filter combos) ─────────────

model ScreenerPreset {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String // "Value + Quality", "Dividend Kings", etc.
  filters   Json // ScreenerFilters as JSON
  sort      Json? // { field, direction }
  isPublic  Boolean  @default(false) // visible to all users
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Email Digest Configuration ─────────────────────────

model EmailDigest {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String // "My weekly value screen"
  filters   Json // ScreenerFilters snapshot
  schedule  String   @default("weekly") // "daily" | "weekly"
  isActive  Boolean  @default(true)
  lastSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive, schedule])
}

// ─── Bookmarks (user watchlist) ──────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId   String
  createdAt DateTime @default(now())

  @@unique([userId, stockId])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── Sync Job Tracking ──────────────────────────────────

model SyncJob {
  id               String    @id @default(cuid())
  jobName          String    @unique // "sync-eod", "sync-fundamentals", "sync-tickers"
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
  tickersProcessed Int       @default(0)
  durationMs       Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── System Configuration (key-value) ───────────────────
//
// EODHD Plan Strategy:
// ┌─────────────────────────────────────────────────────────────────┐
// │  SYNC_MODE=daily  → All World plan ($19.99/mo)                 │
// │    - sync-eod       (Bulk EOD)           ✓ runs daily M-F      │
// │    - sync-tickers   (Exchange symbols)   ✓ runs monthly        │
// │    - sync-fundament (Fundamentals)       ✗ SKIPPED             │
// │                                                                │
// │  SYNC_MODE=full    → All-in-One plan ($99.99/mo)               │
// │    - sync-eod       (Bulk EOD)           ✓ runs daily M-F      │
// │    - sync-tickers   (Exchange symbols)   ✓ runs monthly        │
// │    - sync-fundament (Fundamentals)       ✓ runs weekly Sat     │
// └─────────────────────────────────────────────────────────────────┘
//
// Switch to "full" for 1 month each quarter to refresh fundamentals.
// Annual cost: 8×$19.99 + 4×$99.99 = ~$560 vs $1000 All-in-One/yr.

// ─── Price / Fundamental Alerts ──────────────────────────

model Alert {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId   String
  metric    String // "lastPrice", "peRatio", "dividendYield", etc.
  operator  String // "above" | "below"
  threshold Float
  isTriggered Boolean  @default(false)
  lastTriggeredAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive, isTriggered])
}

model SystemConfig {
  key       String   @id // "SYNC_MODE", etc.
  value     String
  updatedAt DateTime @updatedAt
}
