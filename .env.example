# ===========================================
# Traiders — Environment Variables
# ===========================================

# PostgreSQL
DATABASE_URL=postgresql://traiders:changeme@localhost:5432/traiders

# Docker Compose — PostgreSQL password
POSTGRES_PASSWORD=changeme

# EODHD API
EODHD_API_KEY=your_api_key_here
EODHD_BASE_URL=https://eodhd.com/api

# API Server
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-random-64-char-string

# Frontend
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Worker — Sync mode (can be overridden from admin UI via SystemConfig DB table)
#   "daily" = All World plan ($19.99/mo): EOD prices + tickers only
#   "full"  = All-in-One plan ($99.99/mo): all syncs including fundamentals
SYNC_MODE=daily

# Worker — Cron schedules
SYNC_EOD_CRON="0 22 * * 1-5"
SYNC_FUNDAMENTALS_CRON="0 6 * * 6"
SYNC_TICKERS_CRON="0 3 1 * *"

# Worker — Exchanges to sync (comma-separated)
# See docs: US, PA, LSE, XETRA, TSE, HKEX, etc.
SYNC_EXCHANGES=US

# Email Digests (SMTP) — leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=traiders@example.com
EMAIL_DIGEST_WEEKLY_CRON="0 8 * * 1"

# Logging
LOG_LEVEL=info
