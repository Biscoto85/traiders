# ===========================================
# Stock Screener — Environment Variables
# ===========================================

# PostgreSQL (auto-injecté par Railway en production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stock_screener

# EODHD API
EODHD_API_KEY=your_api_key_here
EODHD_BASE_URL=https://eodhd.com/api

# API Server
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Frontend
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Worker — Cron schedules
SYNC_EOD_CRON="0 22 * * 1-5"
SYNC_FUNDAMENTALS_CRON="0 6 * * 6"
SYNC_TICKERS_CRON="0 3 1 * *"

# Logging
LOG_LEVEL=info
