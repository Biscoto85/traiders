FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/eodhd-client/package.json packages/eodhd-client/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

# Build
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN pnpm --filter @stock-screener/shared build
RUN pnpm --filter @stock-screener/eodhd-client build
RUN pnpm --filter @stock-screener/api db:generate
RUN pnpm --filter @stock-screener/api build

# Production
FROM base AS production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/packages/eodhd-client/node_modules ./packages/eodhd-client/node_modules
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/eodhd-client/dist ./packages/eodhd-client/dist
COPY --from=build /app/packages/eodhd-client/package.json ./packages/eodhd-client/
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY package.json pnpm-workspace.yaml ./

WORKDIR /app/apps/api
EXPOSE 4000
CMD ["node", "dist/server.js"]
